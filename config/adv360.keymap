#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            hold-while-undecided;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&trans  &trans            &trans          &trans              &trans                   &trans  &trans                                                       &mo 5        &trans  &trans               &trans               &trans          &trans            &trans
&trans  &kp Q             &kp W           &kp E               &kp R                    &kp T   &none                                                        &none        &kp Y   &kp U                &kp I                &kp O           &kp P             &trans
&trans  &hm LEFT_GUI A    &hm LEFT_ALT S  &hm LEFT_CONTROL D  &hm LEFT_SHIFT F         &kp G   &none            &trans     &trans      &trans  &trans       &none        &kp H   &hm RIGHT_SHIFT J    &hm RIGHT_CONTROL K  &hm LEFT_ALT L  &hm LEFT_GUI SQT  &trans
&trans  &hm LEFT_SHIFT Z  &kp X           &kp C               &kp V                    &kp B                               &trans      &trans                            &kp N   &kp M                &kp COMMA            &kp DOT         &hm RSHFT SLASH   &trans
&trans  &trans            &trans          &trans              &hm LEFT_COMMAND ESCAPE          &lt 2 BACKSPACE  &lt 4 TAB  &trans      &trans  &lt 3 ENTER  &lt 1 SPACE          &hm LEFT_ALT DELETE  &trans               &trans          &trans            &trans
            >;
        };

        sym {
            display-name = "Symbols";
            bindings = <
&trans  &trans     &trans     &trans          &trans           &trans       &trans                                      &trans  &trans     &trans     &trans         &trans                &trans                 &trans
&trans  &kp EXCL   &kp AT     &kp POUND       &kp DOLLAR       &kp PERCENT  &trans                                      &trans  &kp CARET  &kp AMPS   &kp STAR       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans  &kp TILDE  &kp UNDER  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PIPE     &trans  &trans  &trans      &trans  &trans  &trans  &trans     &trans     &trans         &trans                &kp COLON              &trans
&trans  &kp GRAVE  &kp MINUS  &kp LBKT        &kp RBKT         &trans                       &trans      &trans                  &trans     &kp EQUAL  &kp LESS_THAN  &kp GREATER_THAN      &kp BSLH               &trans
&trans  &trans     &trans     &trans          &trans                        &trans  &trans  &trans      &trans  &trans  &trans             &trans     &trans         &trans                &trans                 &trans
            >;
        };

        num {
            display-name = "Numbers";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans     &trans                                       &trans  &trans    &trans     &trans  &trans  &trans     &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &trans                                       &trans  &kp N6    &kp N7     &kp N8  &kp N9  &kp N0     &trans
&trans  &trans  &trans  &trans  &trans  &kp EQUAL  &trans  &trans  &trans      &trans  &trans   &trans  &kp PLUS  &kp N4     &kp N5  &kp N6  &kp MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &trans      &trans                   &kp STAR  &kp N1     &kp N2  &kp N3  &kp FSLH   &trans
&trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans      &trans  &kp DOT  &kp N0            &kp EQUAL  &trans  &trans  &trans     &trans
            >;
        };

        nav {
            display-name = "Nav";
            bindings = <
&trans  &trans                &trans                &trans             &trans                    &trans                   &trans                                      &trans  &trans         &trans     &trans     &trans     &trans     &trans
&trans  &kp ESCAPE            &trans                &trans             &kp LS(LC(LG(NUMBER_4)))  &kp LS(LG(KP_NUMBER_5))  &trans                                      &trans  &kp LS(LG(Z))  &kp LG(V)  &kp LG(C)  &kp LG(X)  &kp LG(Z)  &trans
&trans  &trans                &trans                &trans             &trans                    &caps_word               &trans  &trans  &trans      &trans  &trans  &trans  &kp LEFT       &kp DOWN   &kp UP     &kp RIGHT  &kp SEMI   &trans
&trans  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP           &kp C_MUTE                               &trans      &trans                  &kp HOME       &kp PG_DN  &kp PG_UP  &kp END    &kp INS    &trans
&trans  &trans                &trans                &trans             &trans                                             &trans  &trans  &trans      &trans  &trans  &trans                 &trans     &trans     &trans     &trans     &trans
            >;
        };

        mouse {
            display-name = "Mouse";
            bindings = <
&trans      &trans                &trans                &trans        &trans           &trans      &trans                                      &trans  &trans  &trans  &trans  &trans  &trans   &trans
&bl BL_TOG  &kp F1                &kp F2                &kp F3        &kp F4           &kp F5      &trans                                      &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans      &trans                &trans                &trans        &trans           &kp ESC     &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F11  &trans
&trans      &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_MUTE                  &trans      &trans                  &trans  &trans  &trans  &trans  &kp F12  &trans
&trans      &trans                &trans                &trans        &trans                       &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &macro_ver    &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
  };
};
