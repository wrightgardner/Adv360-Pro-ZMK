#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
    #include "version.dtsi"
    #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE      &kp N1            &kp N2      &kp N3         &kp N4              &kp N5  &tog 1                                                                                                     &mo 3              &kp N6  &kp N7                   &kp N8                 &kp N9            &kp N0                 &kp MINUS
&kp TAB        &kp Q             &kp W       &kp E          &kp R               &kp T   &bl BL_TOG                                                                                                 &kp EQUAL          &kp Y   &kp U                    &kp I                  &kp O             &kp P                  &kp BSLH
&mt LCTRL ESC  &hm LCTRL A       &kp S       &kp D          &kp F               &kp G   &kp LEFT_BRACKET  &mt LCTRL ESCAPE  &kp LEFT_ALT            &kp LCTRL                  &kp LEFT_GUI        &kp RIGHT_BRACKET  &kp H   &kp J                    &kp K                  &kp L             &hm RCTRL SEMICOLON    &mt RCTRL SQT
&kp LSHFT      &hm LEFT_SHIFT Z  &kp X       &kp C          &kp V               &kp B                                       &kp HOME                &kp PAGE_UP                                                       &kp N   &kp M                    &kp COMMA              &kp DOT           &hm RIGHT_SHIFT SLASH  &kp RSHFT
&mo 2          &none             &caps_word  &hm LALT LEFT  &hm LEFT_GUI RIGHT          &lt 1 BACKSPACE   &mt LEFT_GUI TAB  &mt LEFT_SHIFT END      &mt RIGHT_SHIFT PAGE_DOWN  &mt LEFT_ALT ENTER  &lt 3 SPACE                &hm LEFT_ALT DOWN_ARROW  &hm LEFT_GUI UP_ARROW  &kp LEFT_BRACKET  &kp RIGHT_BRACKET      &mo 2
            >;
        };

        layer_sym {
            bindings = <
&none   &kp F1         &kp F2        &kp F3            &kp F4           &kp F5         &trans                                          &mo 3   &kp F6            &kp F7             &kp F8                &kp F9                 &kp F10                    &kp F11
&none   &kp EXCL       &kp AT        &kp HASH          &kp DOLLAR       &kp PERCENT    &none                                           &none   &kp LCTRL         &kp AMPERSAND      &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS      &kp F12
&trans  &kp LS(GRAVE)  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOLUME_UP  &kp PAGE_UP    &caps_word  &trans  &trans      &trans  &trans  &none   &kp LEFT          &kp DOWN           &kp UP_ARROW          &kp RIGHT              &kp LS(BACKSLASH)          &trans
&trans  &kp GRAVE      &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT       &kp PAGE_DOWN                      &trans      &trans                  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &mt RIGHT_SHIFT BACKSLASH  &trans
&mo 2   &none          &none         &trans            &trans                          &trans      &trans  &trans      &trans  &trans  &kp N0                    &trans             &trans                &trans                 &trans                     &mo 2
            >;
        };

        layer_num {
            bindings = <
&none  &none   &none   &none   &none      &none   &tog 1                                       &mo 3   &none         &none   &none   &none   &none      &none
&none  &kp N1  &kp N2  &kp N3  &kp N4     &kp N5  &none                                        &none   &kp N6        &kp N7  &kp N8  &kp N9  &kp N0     &none
&none  &none   &none   &none   &kp EQUAL  &none   &none   &trans  &trans      &trans  &trans   &none   &kp PLUS      &kp N4  &kp N5  &kp N6  &kp MINUS  &none
&none  &none   &none   &none   &none      &none                   &trans      &trans                   &kp ASTERISK  &kp N1  &kp N2  &kp N3  &kp SLASH  &none
&none  &none   &none   &none   &none              &trans  &trans  &trans      &trans  &kp DOT  &kp N0                &none   &none   &none   &none      &none
            >;
        };

        layer_mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none   &none       &none       &none   &none  &none
&none  &none         &trans        &trans        &none         &trans        &bootloader                                            &bootloader             &none   &none       &trans      &trans  &none  &none
&none  &none         &trans        &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none   &none       &none       &none   &none  &none
&none  &none         &none         &trans        &macro_ver    &none                             &none      &none                                           &trans  &none       &none       &none   &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                 &bl BL_INC  &bl BL_DEC  &none   &none  &none
            >;
        };
    };
};
